# Caddy holt/erneuert das Let's-Encrypt-Zertifikat automatisch fuer diese Domain.
movietaste.de, www.movietaste.de {
	# Komprimiert Antworten (v.a. die grossen JSON-Kataloglisten, ~27MB
	# unkomprimiert) -- ohne diese Zeile schickt Caddy alles unkomprimiert
	# raus, obwohl der Browser per Accept-Encoding gzip anbietet.
	encode zstd gzip

	# Sicherheits-Header fuer JEDE Antwort. Bewusst hier in Caddy und nicht im
	# Backend: Sie gehoeren an die aeusserste Schicht, damit sie auch vor
	# statischen Dateien und Fehlerseiten stehen.
	header {
		# Zwingt den Browser fuer ein Jahr auf HTTPS -- schuetzt vor dem
		# Herabstufen auf HTTP (SSL-Stripping) im offenen WLAN. Kein "preload",
		# das ist eine schwer ruecknehmbare Selbstverpflichtung.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Verhindert das Einbetten in einen fremden iframe (Clickjacking). Die
		# App wird nie in einem Rahmen geoeffnet, geteilte Titel laufen direkt.
		# X-Frame-Options fuer aeltere, frame-ancestors fuer neuere Browser --
		# der CSP-Header enthaelt NUR diese eine Regel und beruehrt deshalb das
		# Inline-Skript der Seite nicht.
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		# Unterbindet MIME-Sniffing: eine Antwort wird als das behandelt, was ihr
		# Content-Type sagt, nicht als das, wonach sie "aussieht".
		X-Content-Type-Options "nosniff"
		# Cross-Origin geht nur die Herkunft mit, nie der Pfad -- so kann der
		# Reset-Token aus /reset-password?token=... nicht ueber den Referer an
		# fremde Server (z.B. TMDB-Bild-CDN) lecken.
		Referrer-Policy "strict-origin-when-cross-origin"
		# Verrät die Caddy-Version nicht.
		-Server
	}

	reverse_proxy backend:3000
}

# ---- CouchUltras (eigenstaendige App, seit 24.08.2026) ----
# Frueher war das ein White-Label DIESER App: derselbe Container, der am Host
# entschied, ob er die Film- oder die Sportfassung ausliefert. Inzwischen ist
# CouchUltras ein eigenes Projekt mit eigenem Repository, eigenem Container und
# eigener Datenbank -- hier steht nur noch die Weiterleitung dorthin.
#
# "couchultras" ist der Dienstname des anderen Compose-Stapels
# (/opt/couchultras). Beide haengen im Netz movietaste_default, deshalb loest
# der Name auf. Er heisst bewusst NICHT "backend": Dieser Name gehoert hier
# schon MovieTaste, und zweimal derselbe Alias im selben Netz haette Caddy mal
# den einen, mal den anderen Container treffen lassen.
# Zertifikat holt Caddy automatisch, sobald der A-Record auf diesen Server
# zeigt (aktiviert 20.08.2026).
couchultras.com, www.couchultras.com {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy couchultras:3000
}
