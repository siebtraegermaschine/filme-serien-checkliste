# Kopieren nach .env und anpassen. .env NIEMALS committen.

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/filme_serien

# Session-Cookie-Secret (langer, zufälliger String -- z.B. `openssl rand -hex 32`)
SESSION_SECRET=change-me

PORT=3000
NODE_ENV=development

# Erlaubter Frontend-Origin für CORS im lokalen Dev-Betrieb (z.B. wenn das Frontend
# separat auf einem anderen Port läuft). In Produktion (gleiche Origin über Caddy)
# nicht nötig -- dann leer lassen.
CORS_ORIGIN=

# E-Mail-Versand (Registrierung, Passwort-Reset). MAIL_PROVIDER=console gibt
# Mails nur in der Konsole aus (Standard für lokale Entwicklung).
MAIL_PROVIDER=console
MAIL_FROM="Filme & Serien <no-reply@example.com>"
RESEND_API_KEY=

# Secret, mit dem die GitHub Action sich beim Streaming-Ingestion-Endpoint
# authentifiziert (POST /api/streaming/ingest). Langer Zufallsstring.
STREAMING_INGEST_SECRET=change-me

# Öffentliche Basis-URL der App (für Links in E-Mails, z.B. Passwort-Reset).
APP_BASE_URL=http://localhost:3000

# TMDB-Key für die Ansehen/Leihen/Kaufen-Buttons in der Detailansicht
# (GET /api/watch-providers/...). Derselbe Key wie in den GitHub-Action-Secrets;
# hier nötig, weil diese Daten erst beim Öffnen eines Titels geholt werden und
# nicht vorab per Action eingespielt werden können. Ohne Key funktioniert die
# App normal weiter, die Buttons zeigen dann nur "nicht verfügbar".
TMDB_API_KEY=
# Region für die Verfügbarkeitsabfrage und wie lange ein Ergebnis gecacht wird.
TMDB_REGION=DE
WATCH_PROVIDERS_TTL_HOURS=24
